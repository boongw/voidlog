# ---------------------------------------------------------------------------
# Database (ADR-005, PostgreSQL via Prisma)
# Local: see docker-compose.yml (service "postgres"). Production: e.g. Neon.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://voidlog:voidlog@localhost:5432/voidlog?schema=public"

# ---------------------------------------------------------------------------
# Queue (ADR-004, Redis/BullMQ)
# Local: see docker-compose.yml (service "redis"). Production: managed Redis.
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Object storage (ADR-003, S3-compatible)
# Local: see docker-compose.yml (service "minio"). Production: e.g. R2.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="voidlog-logs"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# true for local MinIO (path-style URLs), false/empty for R2 & co.
STORAGE_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# dps.report API (ADR-002)
# ---------------------------------------------------------------------------
DPS_REPORT_BASE_URL="https://dps.report"
DPS_REPORT_UPLOAD_PATH="/uploadContent"
DPS_REPORT_JSON_PATH="/getJson"

# ---------------------------------------------------------------------------
# Auth.js with GW2Auth provider (ADR-007, amended: GW2Auth instead of Discord)
# Register a client at https://gw2auth.com/account/client — redirect URI
# for local dev must be http://127.0.0.1:3000/api/auth/callback/gw2auth
# (gw2auth requires 127.0.0.1, "localhost" is not accepted).
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_GW2AUTH_ID=""
AUTH_GW2AUTH_SECRET=""
AUTH_URL="http://127.0.0.1:3000"
